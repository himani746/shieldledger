// prisma/schema.prisma
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  anchoring
  confirmed
  failed
}

model Organization {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  logo_url   String?
  created_at DateTime   @default(now())

  users      User[]
  documents  Document[]

  @@map("organizations")
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  password_hash   String
  role            String       @default("member")  // "admin" | "member"
  organization_id String
  created_at      DateTime     @default(now())

  organization    Organization @relation(fields: [organization_id], references: [id])
  documents       Document[]

  @@map("users")
}

model Document {
  id              String         @id @default(cuid())
  title           String
  document_type   String
  filename        String
  s3_key          String
  file_size_bytes Int
  mime_type       String         @default("application/pdf")
  sha3_hash       String         @unique
  status          DocumentStatus @default(anchoring)
  uploaded_by     String
  organization_id String
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  uploader        User           @relation(fields: [uploaded_by], references: [id])
  organization    Organization   @relation(fields: [organization_id], references: [id])
  versions        DocumentVersion[]
  anchor_events   AnchorEvent[]
  signatories     Signatory[]

  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(cuid())
  document_id String
  version     Int
  sha3_hash   String
  s3_key      String
  label       String?
  created_at  DateTime @default(now())

  document    Document @relation(fields: [document_id], references: [id])

  @@unique([document_id, version])
  @@map("document_versions")
}

model AnchorEvent {
  id          String   @id @default(cuid())
  document_id String
  tx_hash     String   @unique
  block_number BigInt
  network     String   @default("polygon-mumbai")
  gas_used    BigInt?
  version     Int      @default(1)
  anchored_at DateTime @default(now())

  document    Document @relation(fields: [document_id], references: [id])

  @@map("anchor_events")
}

model Signatory {
  id           String    @id @default(cuid())
  document_id  String
  email        String
  name         String?
  invite_token String    @unique
  signed_at    DateTime?
  ip_address   String?
  created_at   DateTime  @default(now())

  document     Document  @relation(fields: [document_id], references: [id])

  @@map("signatories")
}
